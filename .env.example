# Model configuration. Copy to .env and fill in.
# Nothing here is hardcoded anywhere in code/ — swapping or adding a model
# touches this file and code/config/settings.py, never a logic file.

# ── Primary role ──────────────────────────────────────────────────────────
# Reasoning, message extraction, image extraction.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-08-07
GPT_DEPLOYMENT=
# Optional, defaults to "low".
PRIMARY_REASONING_EFFORT=low

# ── Verifier role ─────────────────────────────────────────────────────────
# Reviews a finalized decision. A different model family from the primary by
# policy. Disabled by default — see DECISIONS.md #5 for the measurement.
GEMINI_API_KEY=
GEMINI_MODEL=
VERIFIER_ENABLED=false
